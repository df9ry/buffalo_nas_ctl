with "config/buffalo_nas_ctl_config.gpr";

project Buffalo_Nas_Ctl is

   for Source_Dirs use ("scripts", "src", "config", "etc");
   for Object_Dir use "obj/" & Buffalo_Nas_Ctl_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("buffalo_nas_ctl.adb");
   for Languages use ("Ada", "Shell", "Config", "Service", "YAML", "Dockerfile");

   package Compiler is
      for Default_Switches ("ada") use ("-Og", "-ffunction-sections", "-fdata-sections", "-g", "-gnatW8", "-gnat2022", "-gnatVa", "-gnatwa.X", "-gnatyaABbc-defhiIklM79nOprStux");
      for Driver ("shell")      use "";
      for Driver ("Config")     use "";
      for Driver ("Service")    use "";
      for Driver ("YAML")       use "";
      for Driver ("Dockerfile") use "";
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Naming is
      for Spec_Suffix ("shell")      use ".sh";
      for Body_Suffix ("shell")      use "._sh";
      for Spec_Suffix ("Config")     use ".conf";
      for Body_Suffix ("Config" )    use "._conf";
      for Spec_Suffix ("Service")    use ".service";
      for Body_Suffix ("Service")    use "._service";
      for Spec_Suffix ("YAML")       use ".yml";
      for Body_Suffix ("YAML")       use "._yml";
      for Spec_Suffix ("Dockerfile") use ".dof";
      for Body_Suffix ("Dockerfile") use "._dof";
   end Naming;

end Buffalo_Nas_Ctl;

